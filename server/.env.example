# Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32 — back this up. If lost, stored keys can't be read back.
KEY_ENCRYPTION_SECRET=

# Your domain (no trailing slash) — where the frontend is served and where Stripe/verify/reset
# links send people back to.
SITE_URL=https://lenar.ai
# This server's own public URL (Railway gives you one, or your custom domain) — used to build
# the Google OAuth redirect_uri.
API_BASE_URL=https://lenar-api.up.railway.app

# 7api
UPSTREAM_MAIN_KEY=sk-...
UPSTREAM_BASE_URL=https://7api.st/v1
STATUS_API_KEY=
# Customer price ÷ 7api cost. Must match CREDIT_MARKUP on the Cloudflare /v1 proxy worker and
# VITE_CREDIT_MARKUP on the frontend.
CREDIT_MARKUP=1.25

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth (optional — leave blank to disable the "Continue with Google" button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional — without it, verify/reset emails are logged instead of sent)
RESEND_API_KEY=
EMAIL_FROM=lenar <onboarding@resend.dev>
