# ─── Frontend (Vite) ─── copy to .env for local dev, and add the same values in Vercel ───
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Base URL customers use. Your domain + /v1 (proxied to 7api by api/v1). Use https://7api.st/v1 to skip the proxy.
VITE_API_BASE_URL=https://api.lenar.ai/v1
# Customer price ÷ 7api cost. 1.25 = customers pay $1.25 for every $1 of 7api usage. MUST equal CREDIT_MARKUP.
VITE_CREDIT_MARKUP=1.25

# ─── Vercel only (server side, used by the /v1 proxy) ───
# CREDIT_MARKUP=1.25
# UPSTREAM_BASE_URL=https://7api.st/v1

# ─── Supabase edge functions ─── set with: supabase secrets set KEY=value ───
# STRIPE_SECRET_KEY=sk_live_...           (sk_test_... while testing)
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://lenar.ai              (where Stripe sends customers back; no trailing slash)
# UPSTREAM_MAIN_KEY=sk-...                (your 7api MAIN key; never put this in VITE_ vars)
# UPSTREAM_BASE_URL=https://7api.st/v1
# CREDIT_MARKUP=1.25
# KEY_ENCRYPTION_SECRET=                  (openssl rand -base64 32; keep a backup)
# STATUS_API_KEY=                         (optional: a small 7api subkey for the status page instead of the main key)
