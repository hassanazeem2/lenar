# ─── Frontend (Vite) ─── copy to .env for local dev, and set the same values at build time on Cloudflare ───
# Your Railway backend's public URL (auth, account, keys, checkout).
VITE_API_URL=https://lenar-server-production.up.railway.app
# Base URL customers use for the model API. Your domain + /v1 (proxied to 7api by the Cloudflare worker).
VITE_API_BASE_URL=https://lenar.ai/v1
# Customer price ÷ 7api cost. 1.25 = customers pay $1.25 for every $1 of 7api usage.
# MUST equal CREDIT_MARKUP on the Railway backend and on the Cloudflare worker (wrangler.json).
VITE_CREDIT_MARKUP=1.25

# ─── Railway backend ─── see server/.env.example ───

# ─── Cloudflare worker (wrangler.json `vars`) ───
# UPSTREAM_BASE_URL=https://7api.st/v1
# CREDIT_MARKUP=1.25
